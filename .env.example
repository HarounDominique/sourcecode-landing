# ── Supabase Edge Function secrets ────────────────────────────────────────────
# Set via: supabase secrets set KEY=value
# Or: Supabase dashboard → Project → Edge Functions → Secrets

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

LEMON_SQUEEZY_WEBHOOK_SECRET=your_lemon_squeezy_webhook_secret_here

# ── success.html client-side constant ─────────────────────────────────────────
# Replace SUPABASE_PROJECT_URL in success.html with your actual URL:
# const SUPABASE_URL = 'https://YOUR_PROJECT_REF.supabase.co';
